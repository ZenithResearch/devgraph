# Operator credentials, signing profiles, and local runtime state are not source.
.env
.env.*
!.env.example
*.pem
*.key
credentials/
secrets/
.devgraph/
.DS_Store
dist/

# Local test/build caches.
.coverage
htmlcov/
node_modules/
target/

# Generated SDK bundles and disposable source validation.
packages/web/*.tgz
packages/web/src/internal/
packages/web/sdk-build.json
packages/web/THIRD-PARTY-NOTICES.txt
.sdk-validation/
packages/web/LICENSE
packages/web/NOTICE
