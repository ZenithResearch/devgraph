{
  "@context": {
    "zn": "https://zenith-research.ca/ontology/terms/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "label": "rdfs:label",
    "comment": "rdfs:comment",
    "domain": {
      "@id": "rdfs:domain",
      "@type": "@id"
    },
    "range": {
      "@id": "rdfs:range",
      "@type": "@id"
    },
    "subClassOf": {
      "@id": "rdfs:subClassOf",
      "@type": "@id"
    },
    "versionIRI": {
      "@id": "owl:versionIRI",
      "@type": "@id"
    },
    "versionInfo": "owl:versionInfo",
    "canonicalAuthority": {
      "@id": "zn:canonicalAuthority",
      "@type": "@id"
    },
    "semanticOperation": {
      "@id": "zn:semanticOperation",
      "@type": "@id"
    },
    "equivalentClass": {
      "@id": "owl:equivalentClass",
      "@type": "@id"
    },
    "imports": {
      "@id": "owl:imports",
      "@type": "@id"
    }
  },
  "@graph": [
    {
      "@id": "https://zenith-research.ca/ontology/normalized/modules/vocabulary",
      "@type": "owl:Ontology",
      "versionIRI": "https://zenith-research.ca/ontology/normalized/v0.1.0/modules/vocabulary.jsonld",
      "versionInfo": "0.1.0",
      "imports": [
        "https://zenith-research.ca/ontology/normalized/v0.1.0/modules/core.jsonld"
      ]
    },
    {
      "@id": "zn:StatusSet",
      "@type": "owl:Class",
      "label": "Status Set",
      "comment": "Named status vocabulary.",
      "subClassOf": "zn:Collection"
    },
    {
      "@id": "zn:StatusValue",
      "@type": "owl:Class",
      "label": "Status Value",
      "comment": "One value belonging to a Status Set.",
      "subClassOf": "owl:Thing"
    }
  ]
}
