{
  "$defs": {
    "ResourcePath": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "devgraph.resource-path.v1",
          "title": "Schema",
          "type": "string"
        },
        "path": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Path",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "path"
      ],
      "title": "ResourcePath",
      "type": "object"
    },
    "WriteResource": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "Todo",
            "Proposal",
            "Initiative",
            "Project",
            "Issue",
            "Task",
            "Arena",
            "Decision",
            "ReviewPacket",
            "Handoff",
            "ExternalLink"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "maxItems": 256,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ids"
        }
      },
      "required": [
        "kind"
      ],
      "title": "WriteResource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "operation": {
      "title": "Operation",
      "type": "string"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/WriteResource"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Resources",
      "type": "array"
    },
    "arena_ids": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Arena Ids"
    },
    "schema": {
      "const": "devgraph.path-write-grant.v1",
      "title": "Schema",
      "type": "string"
    },
    "resource_paths": {
      "items": {
        "$ref": "#/$defs/ResourcePath"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Resource Paths",
      "type": "array"
    }
  },
  "required": [
    "operation",
    "resources",
    "schema",
    "resource_paths"
  ],
  "title": "PathWriteGrant",
  "type": "object"
}
