        "type": "string"
      },
      "title": "Work Kinds",
      "type": "array"
    },
    "work_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Work Ids",
      "type": "array"
    },
    "arena_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Arena Ids",
      "type": "array"
    },
    "include_archived": {
      "title": "Include Archived",
      "type": "boolean"
    },
    "schema": {
      "const": "devgraph.path-read-grant.v1",
      "title": "Schema",
      "type": "string"
    },
    "resource_paths": {
      "items": {
        "$ref": "#/$defs/ResourcePath"
