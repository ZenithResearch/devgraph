        "enum": [
          "list",
          "get",
          "relationships",
          "children",
          "blockers"
        ],
        "type": "string"
      },
      "title": "Operations",
      "type": "array"
    },
    "relationship_types": {
      "items": {
        "enum": [
          "children",
          "parent",
          "dependencies",
          "dependents",
          "blockers",
          "blocked"
