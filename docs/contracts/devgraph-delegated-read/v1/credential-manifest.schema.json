{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://work.zenith-research.ca/devgraph/contracts/v1/credential-manifest.schema.json",
  "title": "Devgraph delegated credential manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "credential_id", "request_id", "version", "subject_public_key", "granted_scopes", "audience", "resource", "allowed_origins", "read_grants", "issued_at", "not_before", "expires_at", "replaces_credential_id", "issuer_key_id"],
  "properties": {
    "schema": {"const": "devgraph.credential-manifest.v1"},
    "credential_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "version": {"type": "integer", "minimum": 1},
    "subject_public_key": {"type": "string", "minLength": 1, "maxLength": 4096},
    "granted_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["devgraph.graph.read", "devgraph.work.read", "devgraph.arena.read", "devgraph.observation.read", "devgraph.material.read", "devgraph.document.read", "devgraph.query.read"]}},
    "audience": {"const": "devgraph"},
    "resource": {"const": "https://work.zenith-research.ca/devgraph"},
    "allowed_origins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
    "read_grants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "read-grant.schema.json"}},
    "issued_at": {"type": "string", "format": "date-time"},
    "not_before": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "replaces_credential_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "issuer_key_id": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
