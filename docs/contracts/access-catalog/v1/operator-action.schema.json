          "minimum": 1,
          "title": "Not After",
          "type": "integer"
        },
        "lifetime_seconds": {
          "maximum": 3600,
          "minimum": 60,
          "title": "Lifetime Seconds",
          "type": "integer"
        },
        "read_grants": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/PathReadGrant"
              },
              {
                "$ref": "#/$defs/MonitorWorkGrant"
