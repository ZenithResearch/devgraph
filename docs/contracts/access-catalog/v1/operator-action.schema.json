        "catalog_digest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Catalog Digest Sha256",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
