{
  "$defs": {
    "AccessDraftV2": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "devgraph.access-draft.v2",
          "title": "Schema",
          "type": "string"
        },
        "issuer": {
          "title": "Issuer",
          "type": "string"
        },
        "receiver": {
          "title": "Receiver",
          "type": "string"
        },
        "write_audience": {
          "const": "devgraph://receiver-local",
          "title": "Write Audience",
          "type": "string"
        },
        "subject_public_key": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Public Key"
        },
        "installation_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Installation Id"
        },
        "not_before": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Not Before",
          "type": "integer"
        },
        "not_after": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Not After",
          "type": "integer"
        },
        "lifetime_seconds": {
          "maximum": 3600,
          "minimum": 60,
          "title": "Lifetime Seconds",
          "type": "integer"
        },
        "read_grants": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MonitorWorkGrant"
          },
          "maxItems": 16,
          "title": "Read Grants",
          "type": "array"
        },
        "write_grants": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WriteGrant"
          },
          "maxItems": 64,
          "title": "Write Grants",
          "type": "array"
        },
        "previous_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Digest"
        }
      },
      "required": [
        "schema",
        "issuer",
        "receiver",
        "write_audience",
        "not_before",
        "not_after",
        "lifetime_seconds"
      ],
      "title": "AccessDraftV2",
      "type": "object"
    },
    "MonitorWorkGrant": {
