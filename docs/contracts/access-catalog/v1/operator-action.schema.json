            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Digest"
        },
        "preset": {
          "anyOf": [
            {
              "$ref": "#/$defs/PresetReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schema",
        "issuer",
        "receiver",
        "write_audience",
        "not_before",
        "not_after",
        "lifetime_seconds"
      ],
      "title": "PathAccessDraft",
      "type": "object"
    },
    "PathGrantSelection": {
      "additionalProperties": false,
      "properties": {
        "read": {
          "anyOf": [
            {
              "$ref": "#/$defs/PathAccessDraft"
