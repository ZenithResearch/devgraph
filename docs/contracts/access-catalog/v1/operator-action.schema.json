  "additionalProperties": false,
  "properties": {
    "schema": {
      "enum": [
        "devgraph.access-operator-action.v4",
        "devgraph.access-operator-action.v5"
      ],
      "title": "Schema",
      "type": "string"
    },
    "action": {
      "enum": [
        "inbox",
        "review",
        "approve",
        "deny",
        "status",
        "revoke"
      ],
      "title": "Action",
      "type": "string"
    },
    "action_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Action Id",
      "type": "string"
    },
    "original_action_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Action Id"
    },
    "request_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "expected_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Version"
    },
    "request_digest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Digest Sha256"
    },
    "selection": {
      "anyOf": [
        {
          "$ref": "#/$defs/PathGrantSelection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "review_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Id"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "target_public_key": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Public Key"
    },
    "target_installation_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Installation Id"
    },
    "previous_assignment_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Assignment Digest"
    },
    "limit": {
      "default": 50,
      "maximum": 100,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "after_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "After Id"
    },
    "previous_write_assignment_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Write Assignment Digest"
    }
  },
  "required": [
    "schema",
    "action",
    "action_id"
  ],
  "title": "PathOperatorAction",
  "type": "object"
}
