              "type": "null"
            }
          ],
          "default": null,
          "title": "Read"
        },
        "write": {
          "anyOf": [
            {
              "$ref": "#/$defs/PathAccessDraft"
            },
            {
              "$ref": "#/$defs/WriteAccessDraft"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Write"
        }
      },
      "title": "PathGrantSelection",
      "type": "object"
    },
